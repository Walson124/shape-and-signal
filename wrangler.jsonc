{
  // Cloudflare Worker: serves dist/, emails player feedback from /api/feedback and
  // runs multiplayer rooms (one Durable Object per world) behind /api/room.
  // FEEDBACK_TO (where feedback goes) is a secret set in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starsea",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "send_email": [
    { "name": "FEEDBACK_EMAIL" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "vars": {
    "FEEDBACK_FROM": "feedback@starsea.dev"
  }
}
